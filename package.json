{
  "name": "ragmanage",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @ragmanage/frontend run dev",
    "build": "pnpm --filter @ragmanage/frontend run build",
    "typecheck": "pnpm --filter @ragmanage/frontend run typecheck",
    "lint": "pnpm --filter @ragmanage/frontend run lint",
    "lint:fix": "pnpm --filter @ragmanage/frontend run lint:fix",
    "test": "pnpm --filter @ragmanage/frontend run test",
    "format": "pnpm --filter @ragmanage/frontend run format",
    "format:check": "pnpm --filter @ragmanage/frontend run format:check"
  }
}
