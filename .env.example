# Development only. Generate a local value with infra/scripts/init-env.ps1.
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:16379/0
STORAGE_ROOT=./data/files
# Company-hosted Open WebUI model gateway. Create the API Key in the account page.
MODEL_GATEWAY_BASE_URL=http://172.2.2.230:8080
MODEL_GATEWAY_API_KEY=
# 页面“配置 API Key”使用的全局 Open WebUI 管理 Key；只用于创建医院服务账号，不下发给医院。
OPEN_WEBUI_ADMIN_EMAIL=
OPEN_WEBUI_ADMIN_PASSWORD=
OPEN_WEBUI_SERVICE_EMAIL_DOMAIN=service.ragmanage.local
OPEN_WEBUI_PROVISIONING_ENABLED=false
API_KEY_ENCRYPTION_SECRET=
MODEL_GATEWAY_ALLOWED_MODELS=qwen3-embedding:0.6b,qwen3.8:27b
GENERATION_MODEL=qwen3.8:27b
GENERATION_MAX_TOKENS=1024
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
