    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "22.20.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.5.0",
    "sass": "^1.104.1",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
